# Import this in Vercel: Project Settings -> Environment Variables -> Import .env
# No paid API keys required for the demo.

TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-GuyNeural

# Recommended on Vercel so jobs survive across serverless instances:
# Create a Blob store in Vercel Storage, then paste the token here.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional - only add if you have OpenAI credits:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_TTS_VOICE=onyx
# TTS_PROVIDER=openai
